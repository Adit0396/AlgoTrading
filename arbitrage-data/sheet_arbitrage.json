[["Cross-market arbitrage (simulated): the same company in two markets, priced in US$. Sell the expensive side and buy the cheap one when the price gap strays far from normal; close when it comes back. No orders are placed."], ["Fund: US$5,000 per pair x 7 pairs = US$35,000 (about A$52,692). Entry when the gap is 2+ standard deviations from its 60-day average; exit near average, after 20 days, or if it widens 2 more (stop). Costs included. Benchmark: an Indian arbitrage fund at 6.55% a year on the same money."], ["Real-world limits: Indian rules restrict moving shares between the NSE and US listings; NRIs can't short NSE shares (that means stock futures, in large lots); shorting needs borrowable stock; the markets' closes are hours apart. This measures how often the gaps stray and come back, not money that could be collected."], ["PAIRS TODAY", "Company", "Markets", "US share = local shares", "Latest day", "Premium of US share", "60-day average", "Gap now (z)", "Signal", "Position"], ["INFY / INFY.NS", "Infosys", "India ↔ US", 1, "'2026-11-25", 0.0693, 0.0106, 3.17, "US share expensive: sell US, buy local", "none"], ["WIT / WIPRO.NS", "Wipro", "India ↔ US", 1, "'2026-11-25", 0.0653, 0.0041, 1.75, "none", "none"], ["HDB / HDFCBANK.NS", "HDFC Bank", "India ↔ US", 3, "'2026-11-25", 0.0364, 0.0132, 1.84, "none", "none"], ["IBN / ICICIBANK.NS", "ICICI Bank", "India ↔ US", 2, "'2026-11-25", 0.0328, 0.0075, 2.15, "US share expensive: sell US, buy local", "sell US, buy local since 2026-11-25 (-30.00 US$ so far)"], ["RDY / DRREDDY.NS", "Dr. Reddy's Laboratories", "India ↔ US", 1, "'2026-11-25", 0.019, -0.0057, 1.96, "none", "none"], ["BHP / BHP.AX", "BHP Group", "Australia ↔ US", 2, "'2026-11-25", 0.0214, -0.0043, 1.47, "none", "buy US, sell local since 2026-11-19 (+204.50 US$ so far)"], ["RMD / RMD.AX", "ResMed", "Australia ↔ US", 10, "'2026-11-25", 0.0089, 0.0025, 0.35, "none", "none"], [], ["TOTALS", "Closed trades", "Winners", "Win rate", "P&L (A$)", "Costs paid (A$)", "