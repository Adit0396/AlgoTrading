[["Cross-market arbitrage (simulated): the same company in two markets, priced in US$. Sell the expensive side and buy the cheap one when the price gap strays far from normal; close when it comes back. No orders are placed."], ["Fund: US$5,000 per pair x 7 pairs = US$35,000 (about A$49,837). Entry when the gap is 2+ standard deviations from its 60-day average; exit near average, after 20 days, or if it widens 2 more (stop). Costs included. Benchmark: an Indian arbitrage fund at 6.55% a year on the same money."], ["Real-world limits: Indian rules restrict moving shares between the NSE and US listings; NRIs can't short NSE shares (that means stock futures, in large lots); shorting needs borrowable stock; the markets' closes are hours apart. This measures how often the gaps stray and come back, not money that could be collected."], ["PAIRS TODAY", "Company", "Markets", "US share = local shares", "Latest day", "Premium of US share", "60-day average", "Gap now (z)", "Signal", "Position"], ["INFY / INFY.NS", "Infosys", "India ↔ US", 1, "'2026-11-04", 0.0279, 0.0098, 0.97, "none", "none"], ["WIT / WIPRO.NS", "Wipro", "India ↔ US", 1, "'2026-11-04", 0.0519, 0.0018, 1.48, "none", "sell US, buy local since 2026-10-22 (+139.86 US$ so far)"], ["HDB / HDFCBANK.NS", "HDFC Bank", "India ↔ US", 3, "'2026-11-04", 0.043, 0.0156, 2.27, "US share expensive: sell US, buy local", "none"], ["IBN / ICICIBANK.NS", "ICICI Bank", "India ↔ US", 2, "'2026-11-04", 0.0399, 0.0029, 4.9, "US share expensive: sell US, buy local", "none"], ["RDY / DRREDDY.NS", "Dr. Reddy's Laboratories", "India ↔ US", 1, "'2026-11-03", -0.01, -0.0105, 0.04, "none", "sell US, buy local since 2026-10-23 (+116.54 US$ so far)"], ["BHP / BHP.AX", "BHP Group", "Australia ↔ US", 2, "'2026-11-04", 0.035, -0.0013, 2.28, "US share expensive: sell US, buy local", "none"], ["RMD / RMD.AX", "ResMed", "Australia ↔ US", 10, "'2026-11-04", 0.0324, 0.0044, 1.55, "none", "buy US, sell local since 2026-11-02 (+184.08 US$ so far)"], [],