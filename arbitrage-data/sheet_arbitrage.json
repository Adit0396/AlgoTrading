[["Cross-market arbitrage (simulated): the same company in two markets, priced in US$. Sell the expensive side and buy the cheap one when the price gap strays far from normal; close when it comes back. No orders are placed."], ["Fund: US$5,000 per pair x 7 pairs = US$35,000 (about A$51,370). Entry when the gap is 2+ standard deviations from its 60-day average; exit near average, after 20 days, or if it widens 2 more (stop). Costs included. Benchmark: an Indian arbitrage fund at 6.55% a year on the same money."], ["Real-world limits: Indian rules restrict moving shares between the NSE and US listings; NRIs can't short NSE shares (that means stock futures, in large lots); shorting needs borrowable stock; the markets' closes are hours apart. This measures how often the gaps stray and come back, not money that could be collected."], ["PAIRS TODAY", "Company", "Markets", "US share = local shares", "Latest day", "Premium of US share", "60-day average", "Gap now (z)", "Signal", "Position"], ["INFY / INFY.NS", "Infosys", "India ↔ US", 1, "'2026-11-11", 0.0002, 0.0102, -0.51, "none", "none"], ["WIT / WIPRO.NS", "Wipro", "India ↔ US", 1, "'2026-11-11", 0.0247, 0.0024, 0.65, "none", "none"], ["HDB / HDFCBANK.NS", "HDFC Bank", "India ↔ US", 3, "'2026-11-11", 0.01, 0.0154, -0.44, "none", "none"], ["IBN / ICICIBANK.NS", "ICICI Bank", "India ↔ US", 2, "'2026-11-11", 0.0381, 0.0044, 3.53, "US share expensive: sell US, buy local", "sell US, buy local since 2026-11-05 (-100.56 US$ so far)"], ["RDY / DRREDDY.NS", "Dr. Reddy's Laboratories", "India ↔ US", 1, "'2026-11-11", 0.0122, -0.0086, 1.67, "none", "sell US, buy local since 2026-11-05 (-67.20 US$ so far)"], ["BHP / BHP.AX", "BHP Group", "Australia ↔ US", 2, "'2026-11-11", -0.011, -0.0012, -0.55, "none", "none"], ["RMD / RMD.AX", "ResMed", "Australia ↔ US", 10, "'2026-11-11", 0.0252, 0.004, 1.15, "none", "none"], [], ["TOTALS", "Closed trades", "Winners", "Win rate", "P&L (A$)", "Costs paid (A$)", "Benchmark, same 22 months (A$)", 