[["Cross-market arbitrage (simulated): the same company in two markets, priced in US$. Sell the expensive side and buy the cheap one when the price gap strays far from normal; close when it comes back. No orders are placed."], ["Fund: US$5,000 per pair x 7 pairs = US$35,000 (about A$51,418). Entry when the gap is 2+ standard deviations from its 60-day average; exit near average, after 20 days, or if it widens 2 more (stop). Costs included. Benchmark: an Indian arbitrage fund at 6.55% a year on the same money."], ["Real-world limits: Indian rules restrict moving shares between the NSE and US listings; NRIs can't short NSE shares (that means stock futures, in large lots); shorting needs borrowable stock; the markets' closes are hours apart. This measures how often the gaps stray and come back, not money that could be collected."], ["PAIRS TODAY", "Company", "Markets", "US share = local shares", "Latest day", "Premium of US share", "60-day average", "Gap now (z)", "Signal", "Position"], ["INFY / INFY.NS", "Infosys", "India ↔ US", 1, "'2026-11-12", 0.0003, 0.0102, -0.52, "none", "none"], ["WIT / WIPRO.NS", "Wipro", "India ↔ US", 1, "'2026-11-12", 0.0172, 0.0026, 0.42, "none", "none"], ["HDB / HDFCBANK.NS", "HDFC Bank", "India ↔ US", 3, "'2026-11-12", -0.0115, 0.0155, -2.15, "US share cheap: buy US, sell local", "none"], ["IBN / ICICIBANK.NS", "ICICI Bank", "India ↔ US", 2, "'2026-11-12", 0.0133, 0.0052, 0.78, "none", "sell US, buy local since 2026-11-05 (+27.45 US$ so far)"], ["RDY / DRREDDY.NS", "Dr. Reddy's Laboratories", "India ↔ US", 1, "'2026-11-12", -0.0046, -0.0081, 0.27, "none", "sell US, buy local since 2026-11-05 (+17.96 US$ so far)"], ["BHP / BHP.AX", "BHP Group", "Australia ↔ US", 2, "'2026-11-13", -0.008, -0.0016, -0.36, "none", "none"], ["RMD / RMD.AX", "ResMed", "Australia ↔ US", 10, "'2026-11-13", 0.0066, 0.004, 0.14, "none", "none"], [], ["TOTALS", "Closed trades", "Winners", "Win rate", "P&L (A$)", "Costs paid (A$)", "Benchmark, same 22 months (A$)", "