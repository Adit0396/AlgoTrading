[["Cross-market arbitrage (simulated): the same company in two markets, priced in US$. Sell the expensive side and buy the cheap one when the price gap strays far from normal; close when it comes back. No orders are placed."], ["Fund: US$5,000 per pair x 7 pairs = US$35,000 (about A$52,993). Entry when the gap is 2+ standard deviations from its 60-day average; exit near average, after 20 days, or if it widens 2 more (stop). Costs included. Benchmark: an Indian arbitrage fund at 6.55% a year on the same money."], ["Real-world limits: Indian rules restrict moving shares between the NSE and US listings; NRIs can't short NSE shares (that means stock futures, in large lots); shorting needs borrowable stock; the markets' closes are hours apart. This measures how often the gaps stray and come back, not money that could be collected."], ["PAIRS TODAY", "Company", "Markets", "US share = local shares", "Latest day", "Premium of US share", "60-day average", "Gap now (z)", "Signal", "Position"], ["INFY / INFY.NS", "Infosys", "India ↔ US", 1, "'2026-11-23", 0.0163, 0.0104, 0.32, "none", "none"], ["WIT / WIPRO.NS", "Wipro", "India ↔ US", 1, "'2026-11-23", 0.0292, 0.0034, 0.74, "none", "none"], ["HDB / HDFCBANK.NS", "HDFC Bank", "India ↔ US", 3, "'2026-11-23", 0.0248, 0.0133, 0.9, "none", "none"], ["IBN / ICICIBANK.NS", "ICICI Bank", "India ↔ US", 2, "'2026-11-23", 0.0366, 0.007, 2.66, "US share expensive: sell US, buy local", "none"], ["RDY / DRREDDY.NS", "Dr. Reddy's Laboratories", "India ↔ US", 1, "'2026-11-23", 0.0146, -0.0062, 1.68, "none", "none"], ["BHP / BHP.AX", "BHP Group", "Australia ↔ US", 2, "'2026-11-24", -0.0137, -0.0043, -0.54, "none", "buy US, sell local since 2026-11-19 (+28.18 US$ so far)"], ["RMD / RMD.AX", "ResMed", "Australia ↔ US", 10, "'2026-11-24", 0.0155, 0.0024, 0.71, "none", "none"], [], ["TOTALS", "Closed trades", "Winners", "Win rate", "P&L (A$)", "Costs paid (A$)", "Benchmark, same 22 months (A$)", "vs benchmark (A$)", "Open trades now (A$)"], ["", 1